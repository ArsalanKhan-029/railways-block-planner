[TEMPLATE]
# Supabase project credentials (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Auth model: email/password via Supabase Auth. No OAuth provider is used.
# Accounts are provisioned by the admin in User Management (User Management →
# Create User), except the seeded administrator created by
# supabase/migration_auth_assets.sql:
#   username: railadmin@        (= railadmin@railmind.app)
#   password: byteforce_1

# RailAI assistant (server-only — never exposed to the browser).
# Groq free tier: https://console.groq.com → API Keys (default model: openai/gpt-oss-120b)
GROQ_API_KEY=
# Optional Groq model override (default openai/gpt-oss-120b)
GROQ_MODEL=

# RailAI fallback AND complaint-photo AI analysis (Gemini multimodal vision —
# Groq's free catalog is text-only as of Sept 2026, so image triage REQUIRES
# this key): https://aistudio.google.com/apikey (gemini-2.0-flash)
GEMINI_API_KEY=
GEMINI_MODEL=

# Web Push (VAPID) — driver notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
