# Supabase project credentials (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Auth model: email/password via Supabase Auth. No OAuth provider is used.
# Accounts are provisioned by the admin in User Management (User Management →
# Create User), except the seeded administrator created by
# supabase/migration_auth_assets.sql:
#   username: railadmin@        (= railadmin@railmind.app)
#   password: byteforce_1

# RailAI assistant (server-only — never exposed to the browser).
# Groq free tier: https://console.groq.com → API Keys (llama-3.3-70b-versatile).
GROQ_API_KEY=
# Optional Groq model override (default llama-3.3-70b-versatile)
GROQ_MODEL=
# Fallback if Groq is unavailable: https://aistudio.google.com/apikey (gemini-2.0-flash)
GEMINI_API_KEY=
GEMINI_MODEL=
